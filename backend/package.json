{
  "name": "backend",
  "version": "1.0.0",
  "types": "module",
  "description": "",
  "main": "server.js",
  "scripts": {
    "lint": "eslint .",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env src/server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/unit/**/*.test.js\"",
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --watch src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
