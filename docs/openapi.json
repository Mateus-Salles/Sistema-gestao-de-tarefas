  "/modelos-lancamento": {
   "get": {
    "tags": [
     "Modelos de Lançamento"
    ],
    "summary": "Lista modelos de lançamento (RF11)",
    "responses": {
     "200": {
      "description": "Lista de modelos",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ModeloLancamento"
         }
        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [
     "Modelos de Lançamento"
    ],
    "summary": "Cadastra modelo de lançamento (RF11)",
    "requestBody": {
     "required": true,
