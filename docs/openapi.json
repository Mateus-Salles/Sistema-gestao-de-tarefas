       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Projeto"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     },
     "409": {
      "description": "Cliente inativo — projeto não pode ser criado (RN05)"
     }
