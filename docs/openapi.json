     {
      "$ref": "#/components/parameters/DivisaoFiltro"
     },
     {
      "$ref": "#/components/parameters/KanbanStatusFiltro"
     }
    ],
    "responses": {
     "200": {
      "description": "Tarefas atribuídas ao usuário logado ou criadas por ele",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Tarefa"
         }
        }
       }
      }
     }
    }
   }
  },
  "/usuarios/{id}": {
   "parameters": [
    {
     "$ref": "#/components/parameters/IdPath"
    }
   ],
   "get": {
    "tags": [
     "Usuários"
    ],
    "summary": "Detalhe de um usuário (RF02)",
    "responses": {
     "200": {
      "description": "Dados do usuário",
      "content": {
       "application/json": {
        "schema": {
