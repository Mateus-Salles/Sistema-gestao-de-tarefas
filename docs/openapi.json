  "/tarefas": {
   "get": {
    "tags": [
     "Tarefas"
    ],
    "summary": "Lista tarefas (RF20). Colaborador só vê tarefas atribuídas a ele ou criadas por ele (RN01); tarefas criadas por um colaborador só aparecem para ele e para o administrador (RN02).\n",
    "parameters": [
     {
      "name": "projeto_id",
      "in": "query",
      "schema": {
       "type": "integer"
      }
     },
     {
      "$ref": "#/components/parameters/DivisaoFiltro"
     },
     {
      "name": "responsavel_id",
      "in": "query",
      "schema": {
       "type": "integer"
      }
     },
