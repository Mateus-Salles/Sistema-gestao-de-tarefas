     "200": {
      "description": "Dados do usuário logado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Usuario"
        }
       }
      }
     }
    }
   }
  },
  "/usuarios/me/kanban": {
   "get": {
    "tags": [
     "Kanban"
    ],
    "summary": "Kanban individual do colaborador logado (RF30)",
