  "/projetos": {
   "get": {
    "tags": [
     "Projetos"
    ],
    "summary": "Lista projetos (RF15)",
    "parameters": [
     {
      "name": "cliente_id",
      "in": "query",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "status",
      "in": "query",
      "schema": {
       "$ref": "#/components/schemas/StatusProjeto"
      }
     },
     {
      "$ref": "#/components/parameters/Pagina"
     },
     {
      "$ref": "#/components/parameters/TamanhoPagina"
     }
    ],
    "responses": {
     "200": {
      "description": "Lista de projetos",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "dados": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Projeto"
           }
          },
          "paginacao": {
           "$ref": "#/components/schemas/Paginacao"
          }
         }
        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [
     "Projetos"
    ],
    "summary": "Cria projeto vinculado a um cliente ativo e a um modelo de lançamento (RF15, RN05). Ao criar, o sistema gera automaticamente as tarefas do modelo escolhido, já distribuídas nas divisões (RF16).\n",
