{
 "openapi": "3.0.3",
 "info": {
  "title": "API — Sistema de Gestão de Tarefas (Forge Growth)",
  "description": "API para o sistema de gestão de tarefas inspirado no ClickUp, organizando a execução de lançamentos digitais em Cliente → Projeto → Tarefas, com quadro Kanban e dois níveis de acesso (Administrador e Colaborador).\n",
  "version": "0.1.0",
  "contact": {
   "name": "Forge Growth"
  }
 },
 "servers": [
  {
   "url": "https://api.forcegrowth.com/v1",
   "description": "Ambiente de produção"
  }
 ],
 "tags": [
  {
   "name": "Autenticação"
  },
  {
   "name": "Usuários"
  },
  {
   "name": "Clientes"
  },
  {
   "name": "Modelos de Lançamento"
  },
  {
   "name": "Projetos"
  },
  {
   "name": "Tarefas"
  },
  {
   "name": "Kanban"
  }
 ],
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "paths": {
  "/auth/login": {
   "post": {
    "tags": [
     "Autenticação"
    ],
    "summary": "Login com e-mail e senha (RF01)",
    "security": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "email",
         "senha"
        ],
        "properties": {
         "email": {
          "type": "string",
          "format": "email"
         },
         "senha": {
          "type": "string",
          "format": "password"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Login bem-sucedido",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "token": {
           "type": "string"
          },
          "usuario": {
           "$ref": "#/components/schemas/Usuario"
          }
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/NaoAutorizado"
     }
    }
   }
  },
  "/auth/logout": {
   "post": {
    "tags": [
     "Autenticação"
    ],
    "summary": "Invalida o token/sessão atual",
    "responses": {
     "204": {
      "description": "Logout realizado com sucesso"
     }
    }
   }
  },
  "/auth/senha": {
   "patch": {
    "tags": [
     "Autenticação"
    ],
    "summary": "Usuário logado altera a própria senha (RF04)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "senha_atual",
         "senha_nova"
        ],
        "properties": {
         "senha_atual": {
          "type": "string",
          "format": "password"
         },
         "senha_nova": {
          "type": "string",
          "format": "password"
         }
        }
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Senha alterada com sucesso"
     },
     "401": {
      "$ref": "#/components/responses/NaoAutorizado"
     }
    }
   }
  },
  "/usuarios": {
   "get": {
    "tags": [
     "Usuários"
    ],
    "summary": "Lista usuários (RF02)",
    "parameters": [
     {
      "$ref": "#/components/parameters/StatusUsuarioFiltro"
     },
     {
      "$ref": "#/components/parameters/Pagina"
     },
     {
      "$ref": "#/components/parameters/TamanhoPagina"
     }
    ],
    "responses": {
     "200": {
      "description": "Lista de usuários",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "dados": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Usuario"
           }
          },
          "paginacao": {
           "$ref": "#/components/schemas/Paginacao"
          }
         }
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     }
    }
   },
   "post": {
    "tags": [
     "Usuários"
    ],
    "summary": "Cadastra usuário (RF02)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UsuarioEntrada"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Usuário criado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Usuario"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     },
     "409": {
      "description": "E-mail já cadastrado"
     }
    }
   }
  },
  "/usuarios/me": {
   "get": {
    "tags": [
     "Usuários"
    ],
    "summary": "Dados do usuário logado, usados para definir o que a UI exibe (RF05)",
