      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UsuarioEdicao"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Usuário atualizado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Usuario"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     },
     "404": {
      "$ref": "#/components/responses/NaoEncontrado"
     }
    }
   }
  },
  "/usuarios/{id}/status": {
   "parameters": [
    {
     "$ref": "#/components/parameters/IdPath"
    }
   ],
   "patch": {
    "tags": [
     "Usuários"
    ],
    "summary": "Ativa ou inativa um usuário (RF02, RN08 — histórico de tarefas é preservado)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "$ref": "#/components/schemas/StatusUsuario"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Status atualizado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Usuario"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     }
    }
   }
  },
  "/usuarios/{id}/kanban": {
   "parameters": [
    {
     "$ref": "#/components/parameters/IdPath"
    }
   ],
   "get": {
    "tags": [
     "Kanban"
    ],
    "summary": "Kanban individual de qualquer colaborador, visto pelo administrador (RF31)",
    "parameters": [
     {
      "$ref": "#/components/parameters/DivisaoFiltro"
     },
     {
      "$ref": "#/components/parameters/KanbanStatusFiltro"
     }
    ],
    "responses": {
     "200": {
      "description": "Tarefas atribuídas ao colaborador ou criadas por ele",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/Tarefa"
         }
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     }
    }
   }
  },
