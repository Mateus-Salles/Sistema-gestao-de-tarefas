     "Clientes"
    ],
    "summary": "Ativa ou inativa o cliente (RF07, RF08)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "$ref": "#/components/schemas/StatusCliente"
