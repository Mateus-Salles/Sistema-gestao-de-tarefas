   "patch": {
    "tags": [
     "Modelos de Lançamento"
    ],
    "summary": "Edita modelo de lançamento (RF13)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ModeloLancamentoEntrada"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Modelo atualizado",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ModeloLancamento"
        }
       }
      }
     },
     "403": {
      "$ref": "#/components/responses/ProibidoSomenteAdmin"
     }
    }
   },
   "delete": {
    "tags": [
     "Modelos de Lançamento"
    ],
    "summary": "Exclui modelo de lançamento (RF13). A alteração/exclusão de um modelo não afeta projetos já criados a partir dele (RF14).\n",
