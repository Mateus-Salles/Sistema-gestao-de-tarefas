   "parameters": [
    {
     "$ref": "#/components/parameters/IdPath"
    }
   ],
   "get": {
    "tags": [
     "Modelos de Lançamento"
    ],
    "summary": "Detalhe do modelo, incluindo tarefas padrão (RF12)",
    "responses": {
     "200": {
      "description": "Dados do modelo",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ModeloLancamentoDetalhado"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/NaoEncontrado"
