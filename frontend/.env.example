# Copie este arquivo para .env e ajuste se precisar.

# Endereço da API (back-end Express), já com o prefixo /v1.
VITE_API_URL=http://localhost:3000/v1

# true  = usa o simulador da API dentro do front (não precisa do back-end).
# false = usa o back-end real no endereço acima.
# Usuários de teste do simulador: admin@email.com, joao@email.com,
# maria@email.com e pedro@email.com — senha 123456.
VITE_USAR_SIMULADOR=true
